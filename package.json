{
  "name": "email-starter",
  "version": "2.0.0",
  "description": "Modern email starter with React Email and TypeScript",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "email dev --dir src/emails",
    "build": "email export --dir src/emails --outDir out --pretty",
    "preview": "email export --dir src/emails --outDir out --pretty && echo 'Emails exported to out/'"
  },
  "keywords": [
    "react-email",
    "email",
    "templates",
    "typescript"
  ],
  "author": "Jérémie Néhlil",
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-email": "^6.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  }
}
